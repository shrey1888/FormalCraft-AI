# FormalCraft AI - Environment Configuration Example
# Copy this file to .env.local and populate with your credentials.

# Google Gemini API Key
# (Optional: If omitted, FormalCraft AI runs seamlessly in local mock simulation mode)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
